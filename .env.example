# Postgres connection for the hub. `docker compose up -d` gives you this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/switchboard

# Separate database for tests (wiped between tests).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/switchboard_test

# The hub's planner agent runs on the Claude API. Without a key it uses a simple stand-in.
# Get one at https://console.anthropic.com (Settings > API keys). Also used by
# `npm run demo:planner` and the live planner tests.
ANTHROPIC_API_KEY=
# Optional: which Claude model the planner uses (default claude-opus-5-5).
# PLANNER_MODEL=claude-opus-5-5

# --- Chat to chat (npm run hub) ---------------------------------------------
# A long random string. It's part of your connector and board URLs, so anyone
# with it can use your hub: keep it private. Make one with:  openssl rand -base64 24
SWITCHBOARD_TOKEN=
# Where the hub listens, and the address people reach it on (set this to your
# tunnel's https URL when you add the connector to the Claude app).
PORT=3030
# PUBLIC_URL=https://your-tunnel.trycloudflare.com
OWNER_NAME=Ben

# Grok runs on your xAI key (https://console.x.ai), ChatGPT on your OpenAI key
# (https://platform.openai.com/api-keys). Leave either empty and a labelled
# stand-in takes its place, so everything still runs.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# How long stand-ins pause before replying, so you can watch them on the board.
# STAND_IN_DELAY_MS=1500
