# Postgres for the app. Locally: a Postgres 16 on your machine or Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/switchboard

# Separate database for tests (wiped between tests).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/switchboard_test

# The public address people and AI apps reach. Defaults to http://localhost:3000 locally
# and to Render's URL on Render. Passkeys are tied to this domain: changing it later
# means everyone creates a new passkey.
# BASE_URL=https://switchboard.example.com

# PORT=3000
